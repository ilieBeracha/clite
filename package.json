{
  "name": "@clite-dev/overlay",
  "version": "0.1.0",
  "description": "A dev-only browser overlay that captures UI, network, console, storage, and source context into AI-ready packets.",
  "type": "module",
  "license": "MIT",
  "author": "",
  "keywords": [
    "ai",
    "debugging",
    "developer-tools",
    "overlay",
    "session-context",
    "source-map"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./babel": {
      "types": "./babel/index.d.ts",
      "require": "./babel/index.cjs",
      "default": "./babel/index.cjs"
    }
  },
  "files": [
    "dist",
    "babel",
    "docs",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "vite demo --host 127.0.0.1",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@types/node": "^22.10.5",
    "jsdom": "^26.0.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "vitest": "^2.1.8"
  }
}
